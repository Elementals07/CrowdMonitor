# =====================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =====================================================

# HiveMQ Cloud broker URL (use mqtts:// for TLS)
MQTT_BROKER_URL=mqtts://YOUR_HIVEMQ_HOST.hivemq.cloud:8883

# HiveMQ credentials
MQTT_USERNAME=crowd_esp
MQTT_PASSWORD=YOUR_MQTT_PASSWORD_HERE

# MQTT topics — must match firmware exactly
MQTT_TOPIC_OCCUPANCY=crowd/occupancy
MQTT_TOPIC_CAPACITY=crowd/capacity
MQTT_TOPIC_ENTRY=crowd/entry
MQTT_TOPIC_EXIT=crowd/exit

# Backend HTTP port
PORT=3001

# Facility timezone (IANA format)
FACILITY_TIMEZONE=Asia/Kolkata

# Stale-data threshold in seconds (warn if no message received)
STALE_THRESHOLD_SECONDS=60

# Alert thresholds (percentage)
ALERT_WARNING_PCT=80
ALERT_CRITICAL_PCT=100

# Default capacity if no retained message on startup
DEFAULT_CAPACITY=10
